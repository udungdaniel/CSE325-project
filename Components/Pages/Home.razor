@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using ThreadLine.Data
@using ThreadLine.Models
@inject ApplicationDbContext Db

<PageTitle>Dashboard - ThreadLine</PageTitle>

<h1 class="mb-1">Dashboard</h1>
<p class="text-muted mb-4">Sales performance and inventory overview.</p>

<AuthorizeView>
    <div class="alert alert-primary d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4" role="alert">
        <div>
            Logged in as <strong>@(context.User.Identity?.Name ?? "unknown")</strong>
            @if (context.User.IsInRole("Admin"))
            {
                <span class="badge bg-dark ms-1">Admin</span>
            }
        </div>
        <form action="Account/Logout" method="post" class="m-0">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="" />
            <button type="submit" class="btn btn-sm btn-outline-primary">Log out</button>
        </form>
    </div>
</AuthorizeView>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (isLoading)
{
    <p>Loading dashboard...</p>
}
else
{
    <h4 class="mb-3">Sales Summary</h4>
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Yesterday's Revenue</div>
                    <div class="fs-4 fw-bold">@FormatMoney(yesterdayRevenue)</div>
                    <div class="small text-muted">@yesterdayTransactions transaction(s)</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">This Week's Revenue</div>
                    <div class="fs-4 fw-bold">@FormatMoney(weekRevenue)</div>
                    <div class="small text-muted">@weekTransactions transaction(s)</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">This Month's Revenue</div>
                    <div class="fs-4 fw-bold">@FormatMoney(monthRevenue)</div>
                    <div class="small text-muted">@monthTransactions transaction(s)</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Products in Inventory</div>
                    <div class="fs-4 fw-bold">@totalProducts</div>
                    <div class="small text-muted">@totalUnitsInStock unit(s) available · @lowStockCount low/out-of-stock</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Available Stock</h5>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-1">
                <div class="col-md-4">
                    <label class="form-label">Search Products</label>
                    <input class="form-control"
                           type="search"
                           placeholder="Search by product name..."
                           @bind="searchTerm"
                           @bind:event="oninput" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Filter by Category</label>
                    <select class="form-select" @bind="selectedCategory">
                        <option value="">All Categories</option>
                        @foreach (var category in AvailableCategories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Filter by Stock Status</label>
                    <select class="form-select" @bind="selectedStockStatus">
                        <option value="">All Stock Statuses</option>
                        <option value="InStock">In Stock</option>
                        <option value="LowStock">Low Stock</option>
                        <option value="OutOfStock">Out of Stock</option>
                    </select>
                </div>
            </div>
            <button class="btn btn-outline-secondary btn-sm mt-2 mb-3" @onclick="ClearStockFilters">
                Clear Filters
            </button>

            @if (allProducts.Count == 0)
            {
                <div class="alert alert-secondary mb-0">
                    No products in inventory yet. Add products on the Product Management page.
                </div>
            }
            else if (FilteredAvailableProducts.Count == 0)
            {
                <div class="alert alert-secondary mb-0">
                    No products match your search or filters.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Available Stock</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in FilteredAvailableProducts)
                            {
                                <tr @key="product.Id">
                                    <td class="fw-semibold">@product.Name</td>
                                    <td>@product.Category</td>
                                    <td>@FormatMoney(product.Price)</td>
                                    <td>@product.StockQuantity</td>
                                    <td>
                                        @if (product.StockQuantity == 0)
                                        {
                                            <span class="badge bg-danger">Out of stock</span>
                                        }
                                        else if (product.StockQuantity <= product.ReorderLevel)
                                        {
                                            <span class="badge bg-warning text-dark">Low stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">In stock</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="text-muted small">
                    Showing @FilteredAvailableProducts.Count of @allProducts.Count product(s).
                </div>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Low-Stock Alerts and Restock Estimates</h5>
        </div>
        <div class="card-body">
            <p class="text-muted small">
                Estimates use the last 30 days of recorded sales and an assumed 7-day supplier lead time.
                Adjust the lead-time constant in this page if your supplier usually takes a different number of days.
            </p>

            @if (lowStockItems.Count == 0)
            {
                <div class="alert alert-success mb-0">No products are currently at or below their reorder level.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Current Stock</th>
                                <th>Reorder Level</th>
                                <th>Average Daily Sales</th>
                                <th>Estimated Stockout</th>
                                <th>Suggested Reorder</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in lowStockItems)
                            {
                                <tr @key="item.ProductId">
                                    <td>
                                        <div class="fw-semibold">@item.Name</div>
                                        <div class="text-muted small">@item.Category</div>
                                    </td>
                                    <td>
                                        @if (item.StockQuantity == 0)
                                        {
                                            <span class="badge bg-danger">Out of stock</span>
                                        }
                                        else
                                        {
                                            @item.StockQuantity
                                        }
                                    </td>
                                    <td>@item.ReorderLevel</td>
                                    <td>@(item.AverageDailySales.HasValue ? item.AverageDailySales.Value.ToString("0.00") : "Insufficient history")</td>
                                    <td>@(item.EstimatedStockout.HasValue ? item.EstimatedStockout.Value.ToString("dd MMM yyyy") : "Cannot estimate")</td>
                                    <td>
                                        @if (item.SuggestedReorderDate.HasValue)
                                        {
                                            @if (item.SuggestedReorderDate.Value.Date <= DateTime.Today)
                                            {
                                                <span class="badge bg-danger">Order now</span>
                                            }
                                            else
                                            {
                                                @item.SuggestedReorderDate.Value.ToString("dd MMM yyyy")
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">Review manually</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    // Assumption for the estimate: supplier restocking takes seven calendar days.
    private const int SupplierLeadTimeDays = 7;
    private const int SalesLookbackDays = 30;

    private bool isLoading = true;
    private string? errorMessage;

    private decimal yesterdayRevenue;
    private decimal weekRevenue;
    private decimal monthRevenue;
    private int yesterdayTransactions;
    private int weekTransactions;
    private int monthTransactions;
    private int totalProducts;
    private int totalUnitsInStock;
    private int lowStockCount;
    private List<Product> allProducts = new();
    private List<LowStockItem> lowStockItems = new();

    private string searchTerm = string.Empty;
    private string selectedCategory = string.Empty;
    private string selectedStockStatus = string.Empty;

    private readonly CultureInfo nigeriaCulture = CultureInfo.GetCultureInfo("en-NG");

    private List<string> AvailableCategories =>
        allProducts
            .Select(p => p.Category)
            .Distinct()
            .OrderBy(c => c)
            .ToList();

    private List<Product> FilteredAvailableProducts =>
        allProducts
            .Where(p =>
                string.IsNullOrWhiteSpace(searchTerm) ||
                p.Name.Contains(searchTerm.Trim(), StringComparison.OrdinalIgnoreCase))
            .Where(p =>
                string.IsNullOrWhiteSpace(selectedCategory) ||
                p.Category == selectedCategory)
            .Where(p =>
                selectedStockStatus switch
                {
                    "InStock" => p.StockQuantity > p.ReorderLevel,
                    "LowStock" => p.StockQuantity > 0 &&
                                  p.StockQuantity <= p.ReorderLevel,
                    "OutOfStock" => p.StockQuantity == 0,
                    _ => true
                })
            .OrderBy(p => p.Name)
            .ToList();

    private void ClearStockFilters()
    {
        searchTerm = string.Empty;
        selectedCategory = string.Empty;
        selectedStockStatus = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var today = DateTime.Today;
            var yesterday = today.AddDays(-1);
            var weekStart = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
            var monthStart = new DateTime(today.Year, today.Month, 1);

            yesterdayRevenue = await Db.Sales
                .Where(s => s.SaleDate >= yesterday && s.SaleDate < today)
                .SumAsync(s => (decimal?)s.TotalAmount) ?? 0m;

            weekRevenue = await Db.Sales
                .Where(s => s.SaleDate >= weekStart && s.SaleDate < today.AddDays(1))
                .SumAsync(s => (decimal?)s.TotalAmount) ?? 0m;

            monthRevenue = await Db.Sales
                .Where(s => s.SaleDate >= monthStart && s.SaleDate < today.AddDays(1))
                .SumAsync(s => (decimal?)s.TotalAmount) ?? 0m;

            yesterdayTransactions = await Db.Sales.CountAsync(s => s.SaleDate >= yesterday && s.SaleDate < today);
            weekTransactions = await Db.Sales.CountAsync(s => s.SaleDate >= weekStart && s.SaleDate < today.AddDays(1));
            monthTransactions = await Db.Sales.CountAsync(s => s.SaleDate >= monthStart && s.SaleDate < today.AddDays(1));

            var products = await Db.Products.AsNoTracking().OrderBy(p => p.Name).ToListAsync();
            allProducts = products;
            totalProducts = products.Count;
            totalUnitsInStock = products.Sum(p => p.StockQuantity);

            var lookbackStart = today.AddDays(-SalesLookbackDays);
            var soldQuantities = await (
                from item in Db.SaleItems.AsNoTracking()
                join sale in Db.Sales.AsNoTracking() on item.SaleId equals sale.Id
                where sale.SaleDate >= lookbackStart && sale.SaleDate < today.AddDays(1)
                group item by item.ProductId into grouped
                select new
                {
                    ProductId = grouped.Key,
                    QuantitySold = grouped.Sum(x => x.Quantity)
                }).ToDictionaryAsync(x => x.ProductId, x => x.QuantitySold);

            lowStockItems = products
                .Where(p => p.StockQuantity <= p.ReorderLevel)
                .Select(p =>
                {
                    soldQuantities.TryGetValue(p.Id, out var quantitySold);
                    decimal? averageDailySales = quantitySold > 0
                        ? (decimal)quantitySold / SalesLookbackDays
                        : null;

                    DateTime? stockout = null;
                    DateTime? reorder = null;

                    if (averageDailySales.HasValue && averageDailySales.Value > 0)
                    {
                        var daysUntilStockout = (int)Math.Ceiling(p.StockQuantity / averageDailySales.Value);
                        stockout = today.AddDays(daysUntilStockout);
                        reorder = stockout.Value.AddDays(-SupplierLeadTimeDays);
                    }

                    return new LowStockItem
                    {
                        ProductId = p.Id,
                        Name = p.Name,
                        Category = p.Category,
                        StockQuantity = p.StockQuantity,
                        ReorderLevel = p.ReorderLevel,
                        AverageDailySales = averageDailySales,
                        EstimatedStockout = stockout,
                        SuggestedReorderDate = reorder
                    };
                })
                .OrderBy(p => p.StockQuantity)
                .ThenBy(p => p.Name)
                .ToList();

            lowStockCount = lowStockItems.Count;
        }
        catch (Exception)
        {
            errorMessage = "The dashboard could not load its data. Check the database connection and confirm that the latest migrations have been applied.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string FormatMoney(decimal amount) => amount.ToString("C", nigeriaCulture);

    private sealed class LowStockItem
    {
        public int ProductId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public int StockQuantity { get; set; }
        public int ReorderLevel { get; set; }
        public decimal? AverageDailySales { get; set; }
        public DateTime? EstimatedStockout { get; set; }
        public DateTime? SuggestedReorderDate { get; set; }
    }
}